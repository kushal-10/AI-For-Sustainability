["function (x) ","{","    if (is.character(x)) {","        y <- iconv(x, from = \"\", to = \"UTF-8\", sub = \"byte\")","        y <- ifelse(is.na(y), iconv(x, from = \"CP1252\", to = \"UTF-8\", ","            sub = \"byte\"), y)","        y <- ifelse(is.na(y), iconv(x, from = \"latin1\", to = \"UTF-8\", ","            sub = \"byte\"), y)","        return(y)","    }","    if (is.list(x)) ","        return(lapply(x, to_utf8))","    x","}"]
